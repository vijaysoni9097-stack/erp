# Backend only. Use a separate testing PostgreSQL database and one worker.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SCHEMA=erp_app
REQUIRE_POSTGRES=true
DEBUG=false
CORS_ORIGINS=["https://YOUR-STAGING-UI.onrender.com"]
PASSWORD_RESET_URL=https://YOUR-STAGING-UI.onrender.com/reset-password
