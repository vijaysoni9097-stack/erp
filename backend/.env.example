# Hosted API uses one persistent PostgreSQL database. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
DATABASE_SCHEMA=erp_app
REQUIRE_POSTGRES=true
DEBUG=false
CORS_ORIGINS=["https://your-frontend.example.com","http://localhost:5173"]

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=pharmacy@example.com
SMTP_STARTTLS=true
SMTP_CC_EMAIL=
PASSWORD_RESET_URL=https://your-frontend.example.com/reset-password

# WhatsApp Business Cloud API (server only). All four required to enable sending.
# Approved body parameters: customer name, invoice number, new credit, account balance.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=

# Per-process PostgreSQL connections. Keep total across services/deploys below the provider limit.
DB_POOL_SIZE=2
DB_POOL_TIMEOUT=30
