{
  "name": "pharmacy-erp-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "postinstall": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python3 scripts/run_backend.py",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "python3 scripts/run_backend_tests.py"
  }
}
